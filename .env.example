# Your Unmap browser key, from https://unmap.dev/dashboard (free).
# It ships in the browser bundle: restrict it to your origins (e.g. http://localhost:3203 and your
# production domain) in the dashboard.
NEXT_PUBLIC_UNMAP_KEY=

# Optional. Defaults to https://api.unmap.dev.
# NEXT_PUBLIC_UNMAP_GATEWAY=https://api.unmap.dev

# Optional. The path the app is served under, e.g. /trails. Empty for a site of its own.
# BASE_PATH=

# Only for refreshing the trail data with scripts/fetch-trails.mjs; the app never reads these.
# With a key, the script measures each trail's climb with Unmap Elevation; without one the climb
# is left null and the app's live elevation profile measures it on demand.
# UNMAP_API_KEY=
# UNMAP_GATEWAY=https://api.unmap.dev
